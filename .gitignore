# build output
.build/
speak.exe
*.exe
*.dll
*.lib
*.pdb
*.obj

# fetched weights (~200 MB) — get them with get-models.ps1
models/

# voice samples and generated audio
voices/
samples/
*.wav
*.bmp

# ...but the source clips voices are built from are tracked, so experiments are
# reproducible (see voice-sources/<name>/README.md)
!voice-sources/**/*.wav
!voice-sources/**/*.mp3
!voice-sources/**/*.flac
